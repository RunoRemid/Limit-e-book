# ---------------------------------------------------------------
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun.
#   cp .env.ornek .env
# .env dosyasi .gitignore icindedir; ASLA depoya girmemelidir.
# ---------------------------------------------------------------

# OpenAI API anahtari — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-buraya-kendi-anahtarinizi-yazin

# Varsayilan model (sunucudaki izinli liste ile eslesmeli)
OPENAI_MODEL=gpt-4o-mini

# Sunucunun dinleyecegi kapi
PORT=8787
